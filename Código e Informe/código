// Variable defination
int sensor = A0;
int greenLed = 6;
int yellowLed = 8;
int redLed = 7;
int humidity = 0;

void setup() {
  pinMode(greenLed, OUTPUT); // Pinmode useeful to convert LEDs like to digital output
  pinMode(yellowLed, OUTPUT);
  pinMode(redLed, OUTPUT);
  Serial.begin(9600); // Start serial communication
}

void loop() {
  humidity = analogRead(sensor); //Read the value sent for the humidity sensor
  Serial.print("Humidity: "); // Write on console that word("Humidity")
  Serial.println(humidity); // Write on console the value of humidity va

//Function according to sensor values

  // When is very humid 
  if(humidity <= 400) {
    digitalWrite(redLed, HIGH);
    digitalWrite(yellowLed, LOW);
    digitalWrite(greenLed, LOW);
  }
  // Medium humidity
  else if(humidity >= 400 && humidity <= 700) {
    digitalWrite(redLed, LOW);
    digitalWrite(yellowLed, HIGH);
    digitalWrite(greenLed, LOW);
  }
  // Very dry
  else if(humidity >= 700) {
    digitalWrite(redLed, LOW);
    digitalWrite(yellowLed, LOW);
    digitalWrite(greenLed, HIGH);
  }

  delay(500);
}
